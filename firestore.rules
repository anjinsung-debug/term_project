rules_version = '2';

// 앱은 서버(Streamlit)에서 서비스 계정으로 접속하므로 이 규칙의 영향을 받지 않는다.
// 브라우저나 외부에서 Firestore에 직접 접근하는 것은 모두 막는다.
// 권한 검사는 데이터를 읽고 쓰는 함수 안에서 한다 (pacs/auth.py의 require_role).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
