# 이 파일을 secrets.toml로 복사한 뒤 값을 채운다.
# secrets.toml은 .gitignore에 들어 있어 커밋되지 않는다. 실제 값은 절대 저장소에 올리지 않는다.
# 설정 방법은 README의 "Firebase 설정"을 본다.

[firebase]
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱의 apiKey (이메일 로그인에 사용)
web_api_key = ""
# 서비스 계정 키 파일(JSON)의 경로. 키 파일은 프로젝트 폴더 밖에 둔다. 경로 구분은 / 로 쓴다.
service_account_file = "C:/keys/pacs-firebase.json"

[storage]
# 영상 파일(원본, 처리 결과)을 저장할 폴더. 배포 서버에서는 재시작해도 지워지지 않는 폴더를 지정한다.
data_dir = "data"
