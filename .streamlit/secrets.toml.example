# 이 파일을 secrets.toml로 복사한 뒤 값을 채운다.
# secrets.toml은 .gitignore에 들어 있어 커밋되지 않는다. 실제 값은 절대 저장소에 올리지 않는다.

[firebase]
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 웹 API 키 (이메일 로그인에 사용)
web_api_key = ""
# Firebase Storage를 쓸 경우의 버킷 이름
storage_bucket = ""

[firebase.service_account]
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 받은 JSON의 값을 옮겨 적는다.
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
